# Copy to .env and fill in. .env is git-ignored.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=bist
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bist_news
POSTGRES_TEST_DB=bist_test
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Ollama (runs on the host, not in docker) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b-q4_K_M
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT_SECONDS=120

# --- Collectors ---
# Identify ourselves politely to news sources / KAP.
HTTP_USER_AGENT=bist-news-personal/0.1 (+https://github.com/CagilciBora)
HTTP_MIN_INTERVAL_SECONDS=3
HTTP_CACHE_TTL_SECONDS=1800
RSS_INTERVAL_MINUTES=120
RSS_LOOKBACK_DAYS=7
KAP_INTERVAL_MINUTES=60
KAP_LOOKBACK_DAYS=1

# --- App ---
LOG_LEVEL=INFO
